{%- comment -%}
  Artix Pro presale landing page (single section, used by templates/page.artix-presale.json).

  Shopify setup this section expects (see artix-presale/README.md):
  - One product, three variants in this order: Tier 1, Tier 2, Tier 3.
    Each variant tracks its own inventory (100 / 300 / 600) with "continue selling" OFF.
  - A pre-order selling plan on that product: $5 charged at checkout, balance later.
  - Color (Navy / Black) is sent as the line-item property "Color".
  Every unit count on the page comes from variant.inventory_quantity; nothing is hard-coded.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product
  assign launch = s.launch_price_cents | default: 14999
  assign ship = s.ship_date | default: 'December 15'
  assign open_index = 0
  assign total_cap = 0
  assign total_reserved = 0
  if p != blank
    for v in p.variants limit: 3
      assign i = forloop.index
      assign k = 'tier_' | append: i | append: '_capacity'
      assign cap = s[k] | default: 0
      assign rem = v.inventory_quantity | at_least: 0 | at_most: cap
      assign total_cap = total_cap | plus: cap
      assign total_reserved = total_reserved | plus: cap | minus: rem
      if open_index == 0 and rem > 0 and v.available
        assign open_index = i
      endif
    endfor
  endif
  if open_index > 0
    assign oi = open_index | minus: 1
    assign open_v = p.variants[oi]
    assign ok = 'tier_' | append: open_index | append: '_capacity'
    assign open_rem = open_v.inventory_quantity | at_least: 0 | at_most: s[ok]
    assign open_pct = launch | minus: open_v.price | times: 100.0 | divided_by: launch | round
  endif
  assign launch_money = launch | money
-%}

<div class="ax" data-artix data-color="navy">
  <a class="ax-skip" href="#main">Skip to content</a>

  {%- if p == blank -%}
    <div class="ax-setup-note" role="note">Select the presale product in the theme editor (Artix presale section → Presale product) to show prices and live availability.</div>
  {%- endif -%}

  {%- comment -%} 1. Sticky header {%- endcomment -%}
  <header class="ax-header">
    <div class="ax-wrap ax-header__row">
      <a class="ax-wordmark" href="#top" aria-label="artix, back to top">artix</a>
      <nav class="ax-nav" aria-label="Page sections">
        <button class="ax-nav__toggle" type="button" aria-expanded="false" aria-controls="ax-nav-list">
          <span>Menu</span>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <ul id="ax-nav-list" class="ax-nav__list">
          <li><a href="#features">Features</a></li>
          <li><a href="#compare">Compare</a></li>
          <li><a href="#specs">Specs</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </nav>
      <button class="ax-btn ax-btn--dark ax-btn--sm" type="button" data-reserve="header">Reserve for $5</button>
    </div>
  </header>

  <main id="main">
    {%- comment -%} 2. Hero {%- endcomment -%}
    <section class="ax-hero" id="top" aria-labelledby="ax-hero-title">
      <div class="ax-wrap ax-hero__grid">
        <div class="ax-hero__media ax-card">
          <div class="ax-swap" data-only="navy">
            {%- render 'artix-img', image: s.hero_navy, alt: 'Artix Pro earbuds in Navy in their open charging case', sizes: '(min-width: 960px) 50vw, 100vw', eager: true -%}
          </div>
          <div class="ax-swap" data-only="black">
            {%- render 'artix-img', image: s.hero_black, alt: 'Artix Pro earbuds in Black in their open charging case', sizes: '(min-width: 960px) 50vw, 100vw' -%}
          </div>
        </div>
        <div class="ax-hero__copy">
          <p class="ax-pill">Presale · Ships {{ ship }}</p>
          <h1 id="ax-hero-title" class="ax-h1">Silence, tuned.</h1>
          <p class="ax-lead">Artix Pro wireless earbuds with hybrid adaptive noise cancelling, 6 microphones for crystal-clear calls and Bluetooth 6.1, in an ergonomic fit that stays put. Reserve yours for $5 and lock in the presale price.</p>

          <p class="ax-price" data-when-open {% if open_index == 0 %}hidden{% endif %}>
            <span class="ax-price__big" data-open-price>{% if open_v %}{{ open_v.price | money }}{% endif %}</span>
            <span class="ax-badge ax-badge--amber" data-open-pct>{% if open_v %}{{ open_pct }}% off{% endif %}</span>
            <span class="ax-price__note">presale price · {{ launch_money }} at launch</span>
          </p>
          <p class="ax-price ax-price--soldout" data-when-soldout {% if open_index > 0 %}hidden{% endif %}>
            <span class="ax-price__note">Presale is sold out. Artix Pro launches at {{ launch_money }}.</span>
          </p>

          <fieldset class="ax-colors">
            <legend class="ax-colors__legend">Color: <span data-color-label>Navy</span></legend>
            <div class="ax-colors__row">
              <button type="button" class="ax-chip" data-set-color="navy" aria-pressed="true"><span class="ax-swatch ax-swatch--navy" aria-hidden="true"></span>Navy</button>
              <button type="button" class="ax-chip" data-set-color="black" aria-pressed="false"><span class="ax-swatch ax-swatch--black" aria-hidden="true"></span>Black</button>
            </div>
          </fieldset>

          <div class="ax-actions">
            <button class="ax-btn ax-btn--dark" type="button" data-reserve="hero">Reserve for $5</button>
            <a class="ax-btn ax-btn--outline" href="#how">How presale works</a>
          </div>

          <ul class="ax-trust">
            <li>{%- render 'artix-icon', name: 'check' -%}$5 fully refundable</li>
            <li>{%- render 'artix-icon', name: 'check' -%}Pay the rest when it ships</li>
            <li>{%- render 'artix-icon', name: 'check' -%}Ships {{ ship }}, in time for Christmas</li>
          </ul>
        </div>
      </div>
    </section>

    {%- comment -%} 3. Tiers {%- endcomment -%}
    <section class="ax-section" id="reserve" aria-labelledby="ax-tiers-title" data-view-content>
      <div class="ax-wrap">
        <div class="ax-head ax-head--split">
          <div>
            <p class="ax-eyebrow">Pick your tier</p>
            <h2 id="ax-tiers-title" class="ax-h2" tabindex="-1">The earlier you reserve, the less you pay.</h2>
          </div>
          {%- liquid
            assign cap_th = total_cap | divided_by: 1000
            assign cap_rest = total_cap | modulo: 1000 | prepend: '00' | slice: -3, 3
            assign res_th = total_reserved | divided_by: 1000
            assign res_rest = total_reserved | modulo: 1000 | prepend: '00' | slice: -3, 3
          -%}
          <p class="ax-counter" aria-live="polite"><strong data-total-reserved>{% if res_th > 0 %}{{ res_th }},{{ res_rest }}{% else %}{{ total_reserved | default: 0 }}{% endif %}</strong> of {% if cap_th > 0 %}{{ cap_th }},{{ cap_rest }}{% else %}{{ total_cap | default: 0 }}{% endif %} reserved</p>
        </div>

        <div class="ax-tiers" role="radiogroup" aria-labelledby="ax-tiers-title">
          {%- if p != blank -%}
          {%- for v in p.variants limit: 3 -%}
            {%- liquid
              assign i = forloop.index
              assign k = 'tier_' | append: i | append: '_capacity'
              assign nk = 'tier_' | append: i | append: '_name'
              assign cap = s[k] | default: 0
              assign tname = s[nk]
              assign rem = v.inventory_quantity | at_least: 0 | at_most: cap
              assign reserved = cap | minus: rem
              assign pct_off = launch | minus: v.price | times: 100.0 | divided_by: launch | round
              assign save = launch | minus: v.price | money_without_trailing_zeros
              if cap > 0
                assign fill = reserved | times: 100.0 | divided_by: cap | round
              else
                assign fill = 0
              endif
              if i == open_index
                assign status = 'open'
              elsif rem == 0 or v.available == false
                assign status = 'soldout'
              else
                assign status = 'next'
              endif
            -%}
            <div class="ax-tier ax-card" data-tier="{{ i }}" data-status="{{ status }}">
              <input class="ax-sr" type="radio" name="ax-tier" id="ax-tier-{{ i }}" value="{{ i }}" {% unless status == 'open' %}disabled{% endunless %}
                aria-label="Tier {{ i }} · {{ tname }}, {{ v.price | money }}, {{ rem }} left">
              <label class="ax-tier__hit" for="ax-tier-{{ i }}" aria-hidden="true"></label>
              <div class="ax-tier__top">
                <p class="ax-tier__name">Tier {{ i }} · {{ tname }}</p>
                <span class="ax-badge" data-tier-badge>{% case status %}{% when 'open' %}Open now{% when 'soldout' %}Sold out{% else %}Next{% endcase %}</span>
              </div>
              <p class="ax-tier__price"><span class="ax-tier__amount">{{ v.price | money }}</span> <s class="ax-tier__launch"><span class="ax-sr">launch price </span>{{ launch_money }}</s></p>
              <p class="ax-tier__save">{{ pct_off }}% off · save {{ save }} vs launch price</p>
              <div class="ax-bar" role="progressbar" aria-label="Tier {{ i }} units reserved" aria-valuemin="0" aria-valuemax="{{ cap }}" aria-valuenow="{{ reserved }}" data-tier-bar>
                <span style="width: {{ fill }}%"></span>
              </div>
              <p class="ax-tier__units" data-tier-units>{{ reserved }} / {{ cap }} reserved · {{ rem }} left</p>
              <button class="ax-btn ax-btn--dark ax-btn--block ax-tier__cta" type="button" data-reserve-tier="{{ i }}" {% unless status == 'open' %}disabled{% endunless %}>
                {%- case status -%}{%- when 'open' -%}Reserve for $5{%- when 'soldout' -%}Sold out{%- else -%}Opens when Tier {{ i | minus: 1 }} sells out{%- endcase -%}
              </button>
            </div>
          {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="ax-tiers__foot">
          <div class="ax-colors ax-colors--inline" role="group" aria-label="Color">
            <span class="ax-muted">Color:</span>
            <button type="button" class="ax-chip ax-chip--sm" data-set-color="navy" aria-pressed="true"><span class="ax-swatch ax-swatch--navy" aria-hidden="true"></span>Navy</button>
            <button type="button" class="ax-chip ax-chip--sm" data-set-color="black" aria-pressed="false"><span class="ax-swatch ax-swatch--black" aria-hidden="true"></span>Black</button>
          </div>
          <p class="ax-small">Your price is locked the moment your $5 deposit goes through. Orders ship from {{ ship }}.</p>
          <p class="ax-status" role="status" aria-live="polite" data-status-msg></p>
        </div>
      </div>
    </section>

    {%- comment -%} 4. How presale works {%- endcomment -%}
